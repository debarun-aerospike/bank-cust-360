# Optional Aerospike client settings for an external cluster.
# Point AEROSPIKE_CONFIG_FILE at this file from .env, or copy values into .env.
#
# Example:
#   AEROSPIKE_HOSTS=10.0.0.11:3000,10.0.0.12:3000,10.0.0.13:3000
#   AEROSPIKE_NAMESPACE=bank
#   AEROSPIKE_USER=app_user
#   AEROSPIKE_PASSWORD=change-me

AEROSPIKE_HOSTS=127.0.0.1:3000
AEROSPIKE_NAMESPACE=bank
AEROSPIKE_USER=
AEROSPIKE_PASSWORD=
