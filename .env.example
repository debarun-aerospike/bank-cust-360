# Copy to .env and adjust as needed (docker compose reads .env automatically).

# ---------------------------------------------------------------------------
# Aerospike connection (API, Admin ingest, and seed)
# ---------------------------------------------------------------------------
# Prefer a seed list. Each entry is host or host:port.
# Local Compose lab (default in docker-compose.yml when unset): aerospike:3000
# Native / host-mapped lab port: 127.0.0.1:13000
# External cluster example:
#   AEROSPIKE_HOSTS=10.0.0.11:3000,10.0.0.12:3000
#
# AEROSPIKE_HOSTS=10.0.0.11:3000,10.0.0.12:3000

# Legacy single-host fallback when AEROSPIKE_HOSTS is empty (native runs)
AEROSPIKE_HOST=127.0.0.1
AEROSPIKE_PORT=13000
AEROSPIKE_NAMESPACE=bank

# Optional access-control credentials (Enterprise / security-enabled clusters)
AEROSPIKE_USER=
AEROSPIKE_PASSWORD=

# Optional extra env file loaded by the API (see ops/aerospike.client.env.example)
# AEROSPIKE_CONFIG_FILE=./ops/aerospike.client.env

# Seed size (also sets backend loadgen ID range)
SEED_CUSTOMERS=100
SEED_COUNTRY=India
SEED_CHECKPOINT_EVERY=1000

# Admin bearer token (API + UI)
ADMIN_TOKEN=admin:admin

# Browser-facing API URL baked into the Next.js client at build time
NEXT_PUBLIC_API_BASE=http://127.0.0.1:18000
