# Copy to .env and adjust as needed (docker compose reads .env automatically).

# Seed size (also sets backend loadgen ID range)
SEED_CUSTOMERS=100
SEED_COUNTRY=India
SEED_CHECKPOINT_EVERY=1000

# Admin bearer token (API + UI)
ADMIN_TOKEN=admin:admin

# Browser-facing API URL baked into the Next.js client at build time
NEXT_PUBLIC_API_BASE=http://127.0.0.1:18000
